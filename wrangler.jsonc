{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "kare-site",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./build/client",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
